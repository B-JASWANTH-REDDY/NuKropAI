# NuKropAI Server-Side Production Environment Configuration Template
# DO NOT commit actual secrets or credentials to this file.
# Copy this file to .env (which is strictly ignored by Git) for local development or configure
# these keys directly in your hosting platform's secure environment settings (e.g. Supabase, Render, Railway, AWS ECS).

# =============================================================================
# 1. Government Agriculture & Agmarknet Mandi API (data.gov.in)
# =============================================================================
# Official resource: 9ef84268-d588-465a-a308-a864a43d0070
# Directorate of Marketing and Inspection / Ministry of Agriculture
# Obtain your key from: https://data.gov.in/
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# =============================================================================
# 2. Groq AI Platform (Crop Foliar Vision & ICAR Diagnostics)
# =============================================================================
# Used for server-side agricultural vision analysis and multimodal crop diagnostics.
# Recommended multimodal model: qwen/qwen3.8-27b
# Obtain your keys from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_primary_groq_api_key_here
GROQ_FALLBACK_API_KEY=gsk_your_fallback_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional secondary fallback (Gemini Vision)
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# 3. Supabase Cloud Configuration (PostgreSQL Database, Auth, Realtime)
# =============================================================================
# Project settings: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_public_anon_client_key_here
# Privileged service role key: SERVER-SIDE ONLY. NEVER expose to client or frontend!
SUPABASE_SERVICE_ROLE_KEY=your_server_service_role_key_here
# JWT Secret for server-side token signature verification
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Database direct connection string (PostgreSQL pooler / direct)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
DB_CONNECTION_STRING=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# =============================================================================
# 4. IoT Gateway & Telemetry Telecommunications
# =============================================================================
# MQTT Broker connection for telemetry ingestion
MQTT_BROKER_URL=mqtts://your-mqtt-broker-endpoint:8883
# Tuya IoT Cloud credentials
TUYA_CLIENT_ID=your_tuya_client_id_here
TUYA_SECRET=your_tuya_client_secret_here

# =============================================================================
# 5. Runtime & Server Settings
# =============================================================================
NODE_ENV=production
PORT=3000
REDIS_URL=redis://localhost:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# =============================================================================
# 6. Android Release Signing & Build Security (Optional for local dev, mandatory for CI release)
# =============================================================================
KEYSTORE_PATH=/path/to/your/production_release.keystore
STORE_PASSWORD=your_keystore_password_here
KEY_ALIAS=your_release_key_alias_here
KEY_PASSWORD=your_key_password_here
STRICT_RELEASE_SIGNING=false
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# =============================================================================
# 7. Web Client Variables (Prefixed with VITE_ for Vite bundler)
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_client_key_here
VITE_API_BASE_URL=http://localhost:3000
