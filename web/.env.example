# NuKropAI Web Client Environment Configuration Template
# DO NOT commit actual secrets or credentials to this file.
# Note: VITE_ prefixed variables are baked into public client JavaScript bundles.
# NEVER place private service_role keys, database passwords, or private API secrets here.

# Supabase Public API endpoint & Anonymous Key (safe for public clients)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_client_key_here

# Backend API proxy URL (Fastify backend root, e.g. https://api.nukrop.ai or http://localhost:3000)
VITE_API_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
